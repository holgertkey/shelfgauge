#!/bin/bash
# Installed on the server as /usr/local/sbin/shelfgauge-hub-backup-send (root, 0755) by
# setup.sh with BACKUP=pull. The forced command of the backup key in
# /root/.ssh/authorized_keys: whatever the client asks for, it writes one tar stream of
# the hub's data to stdout and nothing else. The archive root holds hub.sqlite (an
# online .backup snapshot, taken first), hub.toml, terms.txt if there is one, and blobs/
# (after the database, as docs/HUB.md says: a blob without a row is harmless, a row
# without its blob is a broken book).
set -euo pipefail
umask 077
data=/srv/shelfgauge-hub
snap=/var/backups/shelfgauge-hub
# The snapshot is taken as the hub's user, so a WAL or shm file sqlite3 may create
# next to hub.sqlite (the hub stopped) stays the hub's own.
install -d -m 0700 -o shelfgauge -g shelfgauge "$snap"
rm -f "$snap/hub.sqlite"
runuser -u shelfgauge -- sqlite3 "$data/hub.sqlite" ".backup '$snap/hub.sqlite'"
if [ "$(runuser -u shelfgauge -- sqlite3 "$snap/hub.sqlite" 'PRAGMA quick_check;')" != ok ]; then
  echo "shelfgauge-hub-backup-send: the database snapshot failed its check" >&2
  exit 2
fi
cp "$data/hub.toml" "$snap/hub.toml"
rm -f "$snap/terms.txt"
[ -f "$data/terms.txt" ] && cp "$data/terms.txt" "$snap/terms.txt"
logger -t shelfgauge-backup "sending a backup to ${SSH_CLIENT%% *}"
# Exit 1 of GNU tar only means a file changed or vanished while read (a blob written
# or deleted meanwhile); blob writes are atomic renames, temporaries are skipped.
rc=0
tar --numeric-owner --exclude='.tmp*' --warning=no-file-changed --warning=no-file-removed \
  -cf - -C "$snap" . -C "$data" blobs || rc=$?
[ "$rc" -le 1 ] || exit "$rc"
