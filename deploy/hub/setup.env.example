# Settings of setup.sh (copy to setup.env next to it; keep it on the server, 0600).
# setup.sh can be run again after a change here.

# The hub's name (DNS A/AAAA records pointing at this server).
HUB_DOMAIN=hub.example.org
# A staging hub on the same server (its own name, port 8744, throwaway data);
# empty: none.
STAGING_DOMAIN=staging.example.org

# Who runs the hub (the hub's [operator]; only for a hub.toml written the first time).
OPERATOR_NAME="Your Name"
OPERATOR_CONTACT=you@example.org

# The admin login: root (key only) or a user with sudo (then root logs in only through
# forced commands, such as the pull backup's key). The whole public key line.
ADMIN_USER=root
ADMIN_SSH_KEY="ssh-ed25519 AAAA... admin@laptop"

# The deploy keys of CI (deploy.yml), one per hub, each in its own GitHub Environment:
# a key can only install an official release on its own hub (update.sh as a forced
# command). Empty: no deploys from CI to that hub.
DEPLOY_SSH_KEY="ssh-ed25519 AAAA... shelfgauge-deploy-production"
DEPLOY_STAGING_SSH_KEY="ssh-ed25519 AAAA... shelfgauge-deploy-staging"
# The GitHub repository whose releases are installed.
REPO=holgertkey/shelfgauge

# Backups: pull (a computer of yours fetches them through BACKUP_SSH_KEY, see
# backup-pull/), restic (this server pushes them nightly to RESTIC_REPOSITORY with the
# settings of /etc/shelfgauge-hub/backup.env, see docs/HUB.md), or none.
BACKUP=pull
BACKUP_SSH_KEY="ssh-ed25519 AAAA... shelfgauge-hub-backup"
# BACKUP=restic: written into /etc/shelfgauge-hub/backup.env only if that file is missing.
RESTIC_REPOSITORY=
BACKUP_HC_URL=

# The site check every 5 minutes (shelfgauge-hub-watch): a Healthchecks.io ping URL;
# empty: no check (an existing /etc/shelfgauge-hub-watch.env is kept).
WATCH_HC_URL=

# The nightly reboot after updates that need one (the server's time, UTC on most images).
REBOOT_TIME=04:00
