# systemd unit of a shelfgauge hub; see docs/HUB.md.
# Install as /etc/systemd/system/shelfgauge-hub.service, then
#   systemctl daemon-reload && systemctl enable --now shelfgauge-hub
# The user `shelfgauge` (useradd --system shelfgauge) owns /srv/shelfgauge-hub.

[Unit]
Description=shelfgauge hub
After=network-online.target
Wants=network-online.target

[Service]
User=shelfgauge
ExecStart=/usr/local/bin/shelfgauge hub --data /srv/shelfgauge-hub --log-format json
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/shelfgauge-hub

[Install]
WantedBy=multi-user.target
