# ~/.config/shelfgauge-hub-backup/env on the computer that pulls the backups.
RESTIC_REPOSITORY=$HOME/backups/shelfgauge-hub
RESTIC_PASSWORD_FILE=$HOME/.config/shelfgauge-hub-backup/restic-password
# The backup key (its public half is BACKUP_SSH_KEY in the server's setup.env).
SSH_KEY=$HOME/.config/shelfgauge-hub-backup/ssh-key
# The server's address, and the hub's name (the restic snapshots' host).
HUB_HOST=203.0.113.10
HUB_DOMAIN=hub.example.org
# A Healthchecks.io check (no ping for a day: a mail).
HC_URL=https://hc-ping.com/your-check-uuid
